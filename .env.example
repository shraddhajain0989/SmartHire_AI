# ==============================================================================
# SmartHire AI - Environment Configuration Example
# Copy this file to '.env' and fill in your actual credentials.
# ==============================================================================

# MongoDB Connection String (Atlas URI or Local MongoDB instance)
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
# Local fallback: mongodb://localhost:27017/smarthire
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/smarthire?retryWrites=true&w=majority

# Secret key used for signing JWT Authentication tokens (Choose a long, random string)
JWT_SECRET=replace-with-a-strong-jwt-secret-key-for-production

# OpenAI API Key used for AI-based mock interview question generation and response analysis
OPENAI_API_KEY=sk-your-openai-api-key-here

# Allowed origins for Cross-Origin Resource Sharing (CORS), separated by commas
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# HuggingFace Transformer Model name for semantic text similarity evaluation
# Default: sentence-transformers/all-MiniLM-L6-v2 (lightweight and fast)
TRANSFORMER_MODEL=sentence-transformers/all-MiniLM-L6-v2
